{
  "name": "aventa-car-detailing-v2",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "detailing-bookings-remoticojobs",
      "database_id": "eb75d203-a2ac-406b-aa74-81c3060c21ab"
    }
  ],
  // Per-IP booking limits (5/min via BOOKING_LIMITER, 6 new bookings/24h) are OFF on the
  // live site. Set to "on" to re-enable them, e.g. if spam bookings show up.
  "vars": { "BOOKING_LIMITS": "off" },

  // Rate limiter used when BOOKING_LIMITS is on: max 5 POST /api/bookings per IP per minute.
  // namespace_id must be unique per Cloudflare account (don't reuse it in other Workers).
  "ratelimits": [
    {
      "name": "BOOKING_LIMITER",
      "namespace_id": "71401",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Secrets (not stored here): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ADMIN_TOKEN, GHL_WEBHOOK_URL
  // — set with `npx wrangler secret put <NAME>`

  "env": {
    // Stripe TEST-mode copy: `npx wrangler deploy --env test`, secrets with `--env test`.
    // Same D1 database as live (bookings use the same source tag) — delete test rows after testing.
    "test": {
      "name": "aventa-car-detailing-v2-test",
      "vars": { "BOOKING_LIMITS": "off" }, // vars aren't inherited from the top level — keep in sync with live
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "detailing-bookings-remoticojobs",
          "database_id": "eb75d203-a2ac-406b-aa74-81c3060c21ab"
        }
      ],
      "ratelimits": [
        {
          "name": "BOOKING_LIMITER",
          "namespace_id": "71402",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
